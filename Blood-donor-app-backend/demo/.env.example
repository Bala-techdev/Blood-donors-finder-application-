# SmartBlood Backend Environment Configuration Example
# Copy this file to .env and provide your actual production / development credentials.

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/blood_donor_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret - MUST be at least 32 characters (256 bits) for HMAC-SHA256
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min_256_bits!

# Allowed CORS Origins (comma-separated list, NO wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_SEARCH_PER_MINUTE=30

# Emergency Escalation Settings
EMERGENCY_ESCALATION_DELAY_MS=300000
EMERGENCY_ESCALATION_COOLDOWN_MINUTES=30

# Email Verification (SMTP)
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
